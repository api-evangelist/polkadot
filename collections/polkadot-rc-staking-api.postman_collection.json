        {
          "id": "0d6076c6-f267-4aeb-b8ad-7e591d13bbcb",
          "name": "Get payout information for a _Stash_ account on the relay chain.",
          "request": {
            "name": "Get payout information for a _Stash_ account on the relay chain.",
            "description": {
              "content": "Returns payout information for the last specified eras on the relay chain. This endpoint is specifically for Asset Hub and queries the relay chain (Polkadot/Kusama) for staking payout information. If specifying both the depth and era query params, this endpoint will return information for (era - depth) through era. (i.e. if depth=5 and era=20 information will be returned for eras 16 through 20). The _Stash_ account can be either a validator or nominator account.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rc",
                "accounts",
                ":address",
                "staking-payouts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "at",
                  "value": "<unsignedInteger or $hex>",
                  "description": "Block at which to query staking payouts."
                },
                {
                  "disabled": false,
                  "key": "depth",
                  "value": "1",
                  "description": "The number of eras to query for payouts of. Must be less than or equal to `HISTORY_DEPTH`. In cases where `era - (depth -1)` is less than 0, the first era queried will be 0."
                },
                {
                  "disabled": false,
                  "key": "era",
                  "value": "<unsignedInteger>",
                  "description": "The era to query at. Max era payout info is available for is the latest finished era (active_era - 1)."
                },
                {
                  "disabled": false,
                  "key": "unclaimedOnly",
                  "value": "true",
                  "description": "Only return unclaimed rewards."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<SS58>",
                  "key": "address",
                  "description": "(Required) SS58 address of the account. Must be a _Stash_ account."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
