        {
          "id": "1c9c030b-0b0d-43a2-b766-abf0c6e2ca67",
          "name": "Get staking information for a _Stash_ account on the relay chain.",
          "request": {
            "name": "Get staking information for a _Stash_ account on the relay chain.",
            "description": {
              "content": "Returns information about a _Stash_ account's staking activity on the relay chain. This endpoint is specifically for Asset Hub and queries the relay chain (Polkadot/Kusama) for staking information. The _Stash_ account can be either a validator or nominator account.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rc",
                "accounts",
                ":address",
                "staking-info"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "at",
                  "value": "<unsignedInteger or $hex>",
                  "description": "Block at which to query the staking info for the specified account."
                },
                {
                  "disabled": false,
                  "key": "includeClaimedRewards",
                  "value": "true",
                  "description": "When set to `false`, the `claimedRewards` field is not included in the response."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<SS58>",
                  "key": "address",
                  "description": "(Required) SS58 address of the account. Must be a _Stash_ account."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "239473ba-84a1-42dd-ad47-0567504e8569",
              "name": "successful operation",
