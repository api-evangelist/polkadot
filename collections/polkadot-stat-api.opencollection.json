{
  "opencollection": "1.0.0",
  "info": {
    "name": "Polkadot REST Account Stat API",
    "version": "0.1.3"
  },
  "items": [
    {
      "info": {
        "name": "Stat",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get monthly active account statistics",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8080/v1/api/scan/accounts/mau"
          },
          "docs": "Returns monthly active account statistics for the requested date range."
        },
        {
          "info": {
            "name": "Get daily token statistics",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8080/v1/api/scan/daily_token"
          },
          "docs": "Returns daily token statistics for a date range and optional token symbol."
        },
        {
          "info": {
            "name": "Get token price history",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8080/v1/api/scan/price/history"
          },
          "docs": "Returns token price history and EMA metrics for the selected date range and format."
        },
        {
          "info": {
            "name": "Get daily statistics (v2)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8080/v1/api/v2/scan/daily"
          },
          "docs": "Returns daily aggregated chain statistics for the selected category and date range."
        }
      ]
    }
  ],
  "bundled": true
}