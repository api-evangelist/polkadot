        {
          "id": "7597a23a-c258-4af3-9145-8aec3d4afbbb",
          "name": "List Bifrost TokenGateway transfers",
          "request": {
            "name": "List Bifrost TokenGateway transfers",
            "description": {
              "content": "Returns paginated Bifrost TokenGateway transfer records for one address from the dedicated TokenGateway table. Supports filtering by transfer status, source and destination accounts, source and destination chains, block time range, scaled amount range, and asset unique ID. Results are ordered by newest block timestamp first, then by descending row id. The address must be a valid Substrate or EVM address that can be normalized into the indexed account format.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "scan",
                "tokengateway",
                "transfers"
              ],
