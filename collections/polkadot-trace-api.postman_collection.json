              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"at\": {\n    \"hash\": \"string\",\n    \"height\": \"string\"\n  },\n  \"operations\": [\n    {\n      \"phase\": {\n        \"variant\": \"onFinalize\",\n        \"extrinsicIndex\": \"string\"\n      },\n      \"parentSpanId\": {\n        \"name\": \"string\",\n        \"target\": \"string\",\n        \"id\": \"string\"\n      },\n      \"primarySpanId\": {\n        \"name\": \"string\",\n        \"target\": \"string\",\n        \"id\": \"string\"\n      },\n      \"eventIndex\": \"string\",\n      \"address\": \"string\",\n      \"storage\": {\n        \"pallet\": \"string\",\n        \"item\": \"string\",\n        \"field1\": \"string\",\n        \"field2\": \"string\"\n      },\n      \"amount\": {\n        \"values\": \"string\",\n        \"currency\": {\n          \"symbol\": \"KSM\"\n        }\n      }\n    },\n    {\n      \"phase\": {\n        \"variant\": \"onInitialize\",\n        \"extrinsicIndex\": \"string\"\n      },\n      \"parentSpanId\": {\n        \"name\": \"string\",\n        \"target\": \"string\",\n        \"id\": \"string\"\n      },\n      \"primarySpanId\": {\n        \"name\": \"string\",\n        \"target\": \"string\",\n        \"id\": \"string\"\n      },\n      \"eventIndex\": \"string\",\n      \"address\": \"string\",\n      \"storage\": {\n        \"pallet\": \"string\",\n        \"item\": \"string\",\n        \"field1\": \"string\",\n        \"field2\": \"string\"\n      },\n      \"amount\": {\n        \"values\": \"string\",\n        \"currency\": {\n          \"symbol\": \"KSM\"\n        }\n      }\n    }\n  ]\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
