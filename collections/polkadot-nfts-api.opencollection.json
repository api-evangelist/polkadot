          "info": {
            "name": "NFT account balances",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8080/v1/api/scan/nfts/account/balances"
          },
          "docs": "Get NFT balances by account address\nThis API only supports networks with nfts frame"
        },
        {
          "info": {
            "name": "NFT activities",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8080/v1/api/scan/nfts/activities"
          },
          "docs": "Get Nft activities(include nft Created/Issued/Burned...) by nft collection id\nThis API only supports networks with nfts frame"
        },
        {
          "info": {
            "name": "NFT info",
            "type": "http"
